      "id": "d1000000-0000-0000-0000-000000000005",
      "name": "Get campaign for action",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [-3712, 2656],
      "credentials": { "supabaseApi": { "id": "REPLACE_WITH_META_SUPABASE_CRED", "name": "Supabase Meta Ads" } }
    },
    {
      "parameters": { "operation": "getAll", "tableId": "meta_ads_settings", "limit": 1, "filterType": "none" },
      "id": "d1000000-0000-0000-0000-000000000006",
      "name": "Get Meta credentials",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [-3488, 2656],
      "credentials": { "supabaseApi": { "id": "REPLACE_WITH_META_SUPABASE_CRED", "name": "Supabase Meta Ads" } }
    },
    {
      "parameters": {
        "jsCode": "const campaign = $('Get campaign for action').item.json;\nif (!campaign || !campaign.id) throw new Error('No campaign linked to this message (messages.campaign_id is empty) — cannot apply the proposed action.');\nconst token = $('Get Meta credentials').item.json.system_user_token;\nif (!token) throw new Error('meta_ads_settings.system_user_token is not set.');\nconst API = 'https://graph.facebook.com/v21.0';\nconst action = $('Get message').item.json.proposed_action;\nif (!action || !action.action_type) throw new Error('No proposed_action on this message.');\n\nconst campaignId = campaign.meta_campaign_id;\nconst adsetId = campaign.meta_adset_id;\nconst adId = campaign.meta_ad_id;\nconst ops = [];\nlet campaignStatusValue = campaign.status;\nlet newBudgetUsd = campaign.daily_budget_usd;\n\nif (action.action_type === 'update_daily_budget') {\n  if (typeof action.daily_budget_usd !== 'number') throw new Error('proposed_action.daily_budget_usd is missing or not a number.');\n  if (!adsetId) throw new Error('This campaign has no meta_adset_id on file.');\n  ops.push({ url: API + '/' + adsetId, form: { daily_budget: String(Math.round(action.daily_budget_usd * 100)) } });\n  newBudgetUsd = action.daily_budget_usd;\n} else if (action.action_type === 'pause_campaign') {\n  if (!campaignId) throw new Error('This campaign has no meta_campaign_id on file.');\n  ops.push({ url: API + '/' + campaignId, form: { status: 'PAUSED' } });\n  campaignStatusValue = 'paused';\n} else if (action.action_type === 'resume_campaign') {\n  if (!campaignId) throw new Error('This campaign has no meta_campaign_id on file.');\n  ops.push({ url: API + '/' + campaignId, form: { status: 'ACTIVE' } });\n  if (adsetId) ops.push({ url: API + '/' + adsetId, form: { status: 'ACTIVE' } });\n  if (adId) ops.push({ url: API + '/' + adId, form: { status: 'ACTIVE' } });\n  campaignStatusValue = 'active';\n} else {\n  throw new Error('Unknown proposed_action.action_type: ' + action.action_type);\n}\n\nreturn ops.map(op => ({ json: { url: op.url, form: op.form, access_token: token, campaignRowId: campaign.id, actionType: action.action_type, campaignStatusValue, newBudgetUsd } }));\n"
      },
      "id": "d1000000-0000-0000-0000-000000000007",
      "name": "Build Meta ops",
