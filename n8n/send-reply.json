          "conditions": [ { "leftValue": "={{ !!$json.proposed_action }}", "rightValue": true, "operator": { "type": "boolean", "operation": "equals" } } ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d1000000-0000-0000-0000-000000000004",
      "name": "Has proposed_action?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-3936, 2800]
    },
    {
      "parameters": {
        "operation": "get",
        "tableId": "campaigns",
        "filters": { "conditions": [ { "keyName": "id", "keyValue": "={{ $('Get message').item.json.campaign_id }}" } ] }
