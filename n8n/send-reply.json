      "position": [-4608, 2800],
      "webhookId": "meta-send-reply",
      "notes": "Called by MessageThread.tsx 'Approve & send'. Payload: { message_id }. The frontend PATCHes messages.ai_draft_body with the (edited) text FIRST, then fires this. This workflow reads ai_draft_body as the outbound body. Async."
    },
    {
      "parameters": {
        "jsCode": "const id = $json.body.message_id;\nconst uuidRe = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nif (typeof id !== 'string' || !uuidRe.test(id)) {\n  throw new Error('message_id missing or not a valid UUID: ' + JSON.stringify(id));\n}\nreturn [{ json: { message_id: id } }];\n"
      },
      "id": "d1000000-0000-0000-0000-000000000002",
      "name": "Validate message_id",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-4384, 2800]
    },
    {
      "parameters": {
        "operation": "get",
        "tableId": "messages",
        "filters": { "conditions": [ { "keyName": "id", "keyValue": "={{ $json.message_id }}" } ] }
      },
      "id": "d1000000-0000-0000-0000-000000000003",
      "name": "Get message",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [-4160, 2800],
      "credentials": { "supabaseApi": { "id": "REPLACE_WITH_META_SUPABASE_CRED", "name": "Supabase Meta Ads" } }
