# Copy to .env.local and fill in. Vite only exposes VITE_-prefixed vars to the browser.
# Use the anon / publishable key ONLY. Never put the service_role key here or anywhere
# client-side — RLS is the security boundary for this app.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# Base URL of the n8n webhooks (no trailing slash). The frontend POSTs here to
# trigger Meta-side automation; it never calls Meta directly.
VITE_N8N_WEBHOOK_BASE=https://n8n.srv1300653.hstgr.cloud/webhook
